# GAMER ID environment — copy to .env and adjust
# Secret used to sign session cookies / tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin account (created by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gamerid.gg
ADMIN_PASSWORD=ChangeMe#Strong2026

# Max upload size in bytes (default 50MB for clips)
MAX_UPLOAD_BYTES=52428800
